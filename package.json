{
  "name": "tadlockpsychiatry",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:protected": "node scripts/build-protected.mjs",
    "smoke:protected": "npm run build:protected && node scripts/smoke-protected.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.protected.json",
    "pretest": "npm run build:protected",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only storage --project demo-tadlockpsychiatry 'vitest run --config vitest.rules.config.ts'",
    "lint": "eslint . --ignore-pattern \"dist-protected/**\""
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "8.3.4",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  }
}
